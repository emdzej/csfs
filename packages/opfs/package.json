{
  "name": "@emdzej/csfs-opfs",
  "version": "0.1.0",
  "description": "File system over the origin private file system",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
