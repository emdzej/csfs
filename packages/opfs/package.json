  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@emdzej/csfs-core": "workspace:*",
    "@emdzej/csfs-fsa": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1"
  }
}
