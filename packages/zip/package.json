{
  "name": "@emdzej/csfs-zip",
  "version": "0.1.0",
  "description": "Mount a zip archive as a file system, read by range",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdzej/csfs.git",
    "directory": "packages/zip"
  },
  "homepage": "https://github.com/emdzej/csfs/tree/main/packages/zip#readme",
  "bugs": {
    "url": "https://github.com/emdzej/csfs/issues"
  },
  "keywords": [
    "filesystem",
    "browser",
    "zip",
    "range-requests",
    "opfs",
    "file-system-access",
    "http"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@emdzej/csfs-core": "workspace:*",
    "@zip.js/zip.js": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@emdzej/csfs-node": "workspace:*"
  }
}
