{
  "name": "@emdzej/csfs-fsa",
  "version": "0.2.0",
  "description": "File system over a picked directory (File System Access API)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdzej/csfs.git",
    "directory": "packages/fsa"
  },
  "homepage": "https://github.com/emdzej/csfs/tree/main/packages/fsa#readme",
  "bugs": {
    "url": "https://github.com/emdzej/csfs/issues"
  },
  "keywords": [
    "filesystem",
    "browser",
    "zip",
    "range-requests",
    "opfs",
    "file-system-access",
    "http"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@emdzej/csfs-core": "workspace:*"
  },
  "devDependencies": {
    "@emdzej/csfs-node": "workspace:*",
    "@emdzej/csfs-zip": "workspace:*",
    "@types/node": "^22.13.1",
    "@zip.js/zip.js": "^2.10.0"
  }
}
