    "@emdzej/csfs-manifest": "workspace:*",
    "@emdzej/csfs-node": "workspace:*",
    "@emdzej/csfs-zip": "workspace:*",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1"
  }
