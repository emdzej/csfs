{
  "name": "csfs",
  "private": true,
  "version": "0.2.0",
  "description": "Client-side file system — one read API over HTTP, a picked directory, OPFS, and inside zip archives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emdzej/csfs"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @emdzej/csfs-demo dev",
    "cli": "node apps/cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.test.json",
    "check": "turbo run build typecheck && tsc -p tsconfig.test.json && vitest run && prettier --check .",
    "format": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
